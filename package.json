{
  "name": "smart-expense-ai",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "lint:support-copy": "npm --prefix apps/web run lint:support-copy",
    "mobile:bundle": "npm --prefix apps/mobile run build:web",
    "mobile:sync": "npm --prefix apps/mobile run sync",
    "mobile:android": "npm --prefix apps/mobile run open:android",
    "mobile:ios": "npm --prefix apps/mobile run open:ios",
    "mobile:run:android": "npm --prefix apps/mobile run run:android",
    "mobile:run:ios": "npm --prefix apps/mobile run run:ios",
    "mobile:test": "npm --prefix apps/mobile run test:e2e"
  }
}
