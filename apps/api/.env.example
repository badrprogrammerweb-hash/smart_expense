# APP_ENV is deliberately NOT set in this file.
#
# It decides whether API documentation (/docs, /redoc, /openapi.json) and
# diagnostic error detail are exposed, so the application reads it only from the
# real process environment and ignores it in dotenv files — a stray .env must
# never be able to switch those surfaces back on. Setting APP_ENV below would
# have no effect.
#
# Local development (PowerShell), before starting uvicorn:
#   $env:APP_ENV="dev"
# Local development (bash):
#   export APP_ENV=dev
#
# Deployed environments must set it explicitly in the container/process
# environment:
#   APP_ENV=production
#
# Unset, empty, and unrecognized values fail closed: the developer surfaces stay
# disabled. Recognized development values are dev, development, local, test, and
# testing.

# Optional Supabase project URL. The API starts without this value.
SUPABASE_URL="http://127.0.0.1:54321"

# Direct Postgres connection string used by the backend for RLS-aware
# workspace queries. Local secret; do not expose to the frontend or commit a
# real value.
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Optional server-only Supabase service role key. Never expose this value to
# the frontend or commit a real value. The API starts without this value.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional legacy HS256 JWT secret fallback for older Supabase projects.
# Prefer JWKS verification when available. Local secret; do not commit a real
# value.
SUPABASE_JWT_SECRET=""

# Optional comma-separated list of origins the browser-facing apps/web
# frontend is allowed to call this API from (CORS). Defaults to
# http://localhost:3000,http://127.0.0.1:3000 when unset.
CORS_ALLOW_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional server-only payment-provider credentials. Keep real values out of
# version control and never expose them to apps/web or apps/mobile.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SIGNING_SECRET=""
APPLE_APP_STORE_ISSUER_ID=""
APPLE_APP_STORE_KEY_ID=""
APPLE_APP_STORE_PRIVATE_KEY=""
# Production or Sandbox. Xcode StoreKit files are mocked in automated tests
# and are not accepted by the deployed verification endpoint.
APPLE_APP_STORE_ENVIRONMENT="Production"
# JSON array of Apple's public root certificates, each as PEM text or
# base64-encoded DER. Trust anchors stay explicit and backend-only.
APPLE_APP_STORE_ROOT_CERTIFICATES="[]"
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
# Exact OIDC audience and push-auth service account configured on the Google
# Pub/Sub subscription that delivers Play real-time developer notifications.
GOOGLE_PLAY_NOTIFICATION_AUDIENCE=""
GOOGLE_PLAY_NOTIFICATION_SERVICE_ACCOUNT_EMAIL=""
